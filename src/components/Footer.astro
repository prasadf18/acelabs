---
import { site } from "../config/site";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <span>
      © {year} {site.name}, {site.expansion} ·
      <a href={`mailto:${site.email}`}>{site.email}</a>
    </span>
    <span>
      <a href={site.links.github} rel="noopener">GitHub</a>
    </span>
  </div>
</footer>
